# ============================================================================
# SriniMart Configuration
# ============================================================================
# Copy this file to .env and update values for your environment

# Environment
ENVIRONMENT=development

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# PostgreSQL Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=srinimart
DATABASE_USER=postgres
DATABASE_PASSWORD=your_password_here

# SQLite (Development/Testing)
SQLITE_DB_PATH=./data/srinimart.db

# JWT Authentication
JWT_SECRET=your_jwt_secret_here_min_32_chars
JWT_EXPIRY_HOURS=24

# Password Hashing (Argon2id)
ARGON2_OPS_LIMIT=3
ARGON2_MEM_LIMIT=65536

# AI Chatbot - Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/models/gemini-pro:generateContent

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# Logging
LOG_LEVEL=info
LOG_DIR=logs

# CORS
CORS_ALLOWED_ORIGINS=*
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization
CORS_MAX_AGE=86400

# Cache
CACHE_MAX_ENTRIES=1000
CACHE_DEFAULT_TTL_SECONDS=300
