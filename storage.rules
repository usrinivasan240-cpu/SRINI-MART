rules_version = '2';
// ============================================================================
// File:    storage.rules
// Purpose: Firebase security rules for uploaded files (product photos).
// ⭐ WHAT THIS FILE IS (plain English):
//     The security guard for the file storage (product images). Anyone logged
//     in may view the images. A seller may upload only into their OWN product
//     folder, only small files (< 5 MB), and only images (not scripts). The
//     last rule closes the door for everything else, so nothing can sneak in
//     outside the product folders.
// Deployed with: firebase deploy --only storage
// ============================================================================

service firebase.storage {
  match /b/{bucket}/o {

    // Helper: is the visitor logged in at all?
    function signedIn() {
      return request.auth != null;
    }

    // Helper: is the logged-in user an admin? (Asked against the database.)
    function isAdmin() {
      return signedIn() &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Products are served to the app.
    match /products/{productId}/{fileName} {
      allow read: if signedIn();
      // Sellers may only upload images into their own product folders.
      allow write: if signedIn()
        && firestore.get(/databases/(default)/documents/products/$(productId)).data.sellerId == request.auth.uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isAdmin();
    }

    // Catch-all: anywhere else in storage is off-limits to everyone.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
